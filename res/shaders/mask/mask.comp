#version 460 core
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0) uniform sampler2D inputTex;
layout(binding = 1) uniform sampler2D mainDepthTex;
layout(binding = 2) uniform usampler2D maskTex;
layout(binding = 3) uniform sampler2D customDepthTex;
layout(rgba16f, binding = 0) uniform image2D outputImg;

uniform vec4 xrayColor = vec4(1.0, 0.0, 0.0, 1.0f);
uniform float xrayIntensity = 1.0f;
uniform vec4 outlineColor = vec4(0.0, 1.0, 0.0, 1.0f);
uniform float outlineIntensity = 1.0f;

const uint MASK_XRAY = 1u;
const uint MASK_OUTLINE = 2u;

float getOutlineValue(ivec2 coord) {
    uint mask = texelFetch(maskTex, coord, 0).r;
    return ((mask & MASK_OUTLINE) != 0u) ? 1.0 : 0.0;
}

void main() {
    ivec2 texCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = textureSize(inputTex, 0);
    if (texCoord.x >= size.x || texCoord.y >= size.y) return;

    vec4 sceneColor = texelFetch(inputTex, texCoord, 0);
    uint maskData = texelFetch(maskTex, texCoord, 0).r;

    float edgeStrength = 0.0;
    edgeStrength += getOutlineValue(texCoord + ivec2(1, 0));
    edgeStrength += getOutlineValue(texCoord + ivec2(-1, 0));
    edgeStrength += getOutlineValue(texCoord + ivec2(0, 1));
    edgeStrength += getOutlineValue(texCoord + ivec2(0, -1));

    float currentOutlineValue = ((maskData & MASK_OUTLINE) != 0u) ? 1.0 : 0.0;
    edgeStrength -= 4.0 * currentOutlineValue;

    bool isOutlineEdge = abs(edgeStrength) > 0.1;

    float mainDepth = texelFetch(mainDepthTex, texCoord, 0).r;
    float customDepth = texelFetch(customDepthTex, texCoord, 0).r;

    bool isOccluded = (customDepth > mainDepth);

    bool hasXRayMask = (maskData & MASK_XRAY) != 0u;

    if (isOutlineEdge) {
        vec3 finalOutline = mix(sceneColor.rgb, outlineColor.rgb * outlineIntensity, outlineColor.a);
        imageStore(outputImg, texCoord, vec4(finalOutline, 1.0));
    } else if (hasXRayMask && isOccluded) {
        vec3 finalXray = mix(sceneColor.rgb, xrayColor.rgb * xrayIntensity, xrayColor.a);
        imageStore(outputImg, texCoord, vec4(finalXray, 1.0));
    } else {
        imageStore(outputImg, texCoord, sceneColor);
    }
}
