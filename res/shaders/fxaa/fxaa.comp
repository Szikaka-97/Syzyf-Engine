#version 460 core

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0) uniform sampler2D inputTex;
layout(rgba16f, binding = 0) uniform writeonly image2D outputImg;

uniform float debugEdges;

uniform float edgeThreshold;
uniform float edgeThresholdMin;
uniform float subpixCap;
uniform float subpixTrim;
uniform float searchThreshold;
uniform float searchSteps;

float FxaaLuma(vec3 rgb)
{
    return rgb.g * (0.587 / 0.299) + rgb.r;
}

vec3 FxaaLerp3(vec3 a, vec3 b, float amountOfA)
{
    return b + amountOfA * (a - b);
}

vec4 FxaaTexOff(sampler2D tex, vec2 pos, ivec2 off, vec2 rcpFrame)
{
    vec2 uv = pos + vec2(off) * rcpFrame;
    return texture(tex, uv);
}

vec3 FxaaPixelShader(vec2 pos, sampler2D tex, vec2 rcpFrame)
{
    vec3 rgbN = FxaaTexOff(tex, pos, ivec2( 0,-1), rcpFrame).rgb;
    vec3 rgbW = FxaaTexOff(tex, pos, ivec2(-1, 0), rcpFrame).rgb;
    vec3 rgbM = FxaaTexOff(tex, pos, ivec2( 0, 0), rcpFrame).rgb;
    vec3 rgbE = FxaaTexOff(tex, pos, ivec2( 1, 0), rcpFrame).rgb;
    vec3 rgbS = FxaaTexOff(tex, pos, ivec2( 0, 1), rcpFrame).rgb;

    float lumaN = FxaaLuma(rgbN);
    float lumaW = FxaaLuma(rgbW);
    float lumaM = FxaaLuma(rgbM);
    float lumaE = FxaaLuma(rgbE);
    float lumaS = FxaaLuma(rgbS);

    float rangeMin = min(lumaM, min(min(lumaN, lumaW), min(lumaS, lumaE)));
    float rangeMax = max(lumaM, max(max(lumaN, lumaW), max(lumaS, lumaE)));
    float range = rangeMax - rangeMin;

    if (range < max(edgeThresholdMin, rangeMax * edgeThreshold))
    return rgbM;

    vec3 rgbL = rgbN + rgbW + rgbM + rgbE + rgbS;

    float lumaL = (lumaN + lumaW + lumaE + lumaS) * 0.25;
    float rangeL = abs(lumaL - lumaM);

    float subpixTrimScale = 1.0 / max(1.0 - subpixTrim, 1e-4);
    float blendL = max(0.0, (rangeL / max(range, 1e-4)) - subpixTrim) * subpixTrimScale;
    blendL = min(subpixCap, blendL);

    vec3 rgbNW = FxaaTexOff(tex, pos, ivec2(-1,-1), rcpFrame).rgb;
    vec3 rgbNE = FxaaTexOff(tex, pos, ivec2( 1,-1), rcpFrame).rgb;
    vec3 rgbSW = FxaaTexOff(tex, pos, ivec2(-1, 1), rcpFrame).rgb;
    vec3 rgbSE = FxaaTexOff(tex, pos, ivec2( 1, 1), rcpFrame).rgb;
    rgbL += rgbNW + rgbNE + rgbSW + rgbSE;
    rgbL *= 1.0 / 9.0;

    float lumaNW = FxaaLuma(rgbNW);
    float lumaNE = FxaaLuma(rgbNE);
    float lumaSW = FxaaLuma(rgbSW);
    float lumaSE = FxaaLuma(rgbSE);

    float edgeVert =
    abs((0.25 * lumaNW) + (-0.5 * lumaN) + (0.25 * lumaNE)) +
    abs((0.50 * lumaW ) + (-1.0 * lumaM) + (0.50 * lumaE )) +
    abs((0.25 * lumaSW) + (-0.5 * lumaS) + (0.25 * lumaSE));

    float edgeHorz =
    abs((0.25 * lumaNW) + (-0.5 * lumaW) + (0.25 * lumaSW)) +
    abs((0.50 * lumaN ) + (-1.0 * lumaM) + (0.50 * lumaS )) +
    abs((0.25 * lumaNE) + (-0.5 * lumaE) + (0.25 * lumaSE));

    bool horzSpan = edgeHorz >= edgeVert;
    float lengthSign = horzSpan ? -rcpFrame.y : -rcpFrame.x;

    if (!horzSpan)
    {
        lumaN = lumaW;
        lumaS = lumaE;
    }

    float gradientN = abs(lumaN - lumaM);
    float gradientS = abs(lumaS - lumaM);
    lumaN = 0.5 * (lumaN + lumaM);
    lumaS = 0.5 * (lumaS + lumaM);

    if (gradientN < gradientS)
    {
        lumaN = lumaS;
        gradientN = gradientS;
        lengthSign *= -1.0;
    }

    vec2 posN;
    posN.x = pos.x + (horzSpan ? 0.0 : lengthSign * 0.5);
    posN.y = pos.y + (horzSpan ? lengthSign * 0.5 : 0.0);

    float gradientSearch = gradientN * searchThreshold;

    vec2 posP = posN;
    vec2 offNP = horzSpan ? vec2(rcpFrame.x, 0.0) : vec2(0.0, rcpFrame.y);

    float lumaEndN = lumaN;
    float lumaEndP = lumaN;
    bool doneN = false;
    bool doneP = false;

    posN += offNP * vec2(-1.0, -1.0);
    posP += offNP * vec2( 1.0,  1.0);

    int steps = int(searchSteps);

    for (int i = 0; i < steps; ++i)
    {
        if (!doneN)
        lumaEndN = FxaaLuma(texture(tex, posN).rgb);

        if (!doneP)
        lumaEndP = FxaaLuma(texture(tex, posP).rgb);

        doneN = doneN || (abs(lumaEndN - lumaN) >= gradientSearch);
        doneP = doneP || (abs(lumaEndP - lumaN) >= gradientSearch);

        if (doneN && doneP)
        break;

        if (!doneN)
        posN -= offNP;

        if (!doneP)
        posP += offNP;
    }

    float dstN = horzSpan ? (pos.x - posN.x) : (pos.y - posN.y);
    float dstP = horzSpan ? (posP.x - pos.x) : (posP.y - pos.y);

    bool directionN = dstN < dstP;
    float lumaEnd = directionN ? lumaEndN : lumaEndP;

    if (((lumaM - lumaN) < 0.0) == ((lumaEnd - lumaN) < 0.0))
    lengthSign = 0.0;

    float spanLength = dstP + dstN;
    float dst = directionN ? dstN : dstP;

    float subPixelOffset = 0.0;
    if (spanLength > 1e-4)
    subPixelOffset = (0.5 + (dst * (-1.0 / spanLength))) * lengthSign;

    vec2 finalUv = vec2(
    pos.x + (horzSpan ? 0.0 : subPixelOffset),
    pos.y + (horzSpan ? subPixelOffset : 0.0)
    );

    vec3 rgbF = texture(tex, finalUv).rgb;

    return FxaaLerp3(rgbL, rgbF, blendL);
}

void main()
{
    ivec2 texCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = textureSize(inputTex, 0);

    if (texCoord.x >= size.x || texCoord.y >= size.y)
    return;

    vec4 src = texelFetch(inputTex, texCoord, 0);

    vec2 uv = (vec2(texCoord) + vec2(0.5)) / vec2(size);
    vec2 rcpFrame = 1.0 / vec2(size);

    if (debugEdges > 0.5)
    {
        vec3 rgbN = FxaaTexOff(inputTex, uv, ivec2( 0,-1), rcpFrame).rgb;
        vec3 rgbW = FxaaTexOff(inputTex, uv, ivec2(-1, 0), rcpFrame).rgb;
        vec3 rgbM = FxaaTexOff(inputTex, uv, ivec2( 0, 0), rcpFrame).rgb;
        vec3 rgbE = FxaaTexOff(inputTex, uv, ivec2( 1, 0), rcpFrame).rgb;
        vec3 rgbS = FxaaTexOff(inputTex, uv, ivec2( 0, 1), rcpFrame).rgb;

        float lumaN = FxaaLuma(rgbN);
        float lumaW = FxaaLuma(rgbW);
        float lumaM = FxaaLuma(rgbM);
        float lumaE = FxaaLuma(rgbE);
        float lumaS = FxaaLuma(rgbS);

        float rangeMin = min(lumaM, min(min(lumaN, lumaW), min(lumaS, lumaE)));
        float rangeMax = max(lumaM, max(max(lumaN, lumaW), max(lumaS, lumaE)));
        float range = rangeMax - rangeMin;

        float edge = (range >= max(edgeThresholdMin, rangeMax * edgeThreshold)) ? 1.0 : 0.0;
        imageStore(outputImg, texCoord, vec4(edge, edge, edge, 1.0));
        return;
    }

    vec3 aa = FxaaPixelShader(uv, inputTex, rcpFrame);
    imageStore(outputImg, texCoord, vec4(aa, src.a));
}
